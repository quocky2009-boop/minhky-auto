# MINH KỲ AUTO — biến môi trường. Chỉ là mẫu: KHÔNG ghi giá trị thật vào file này.
# Sao chép thành .env.local (máy dev) hoặc khai báo trong Vercel → Project Settings → Environment Variables.

# Supabase project RIÊNG của showroom (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chỉ dùng phía máy chủ để mời nhân viên. KHÔNG thêm tiền tố NEXT_PUBLIC_. Không bắt buộc:
# thiếu khóa này app vẫn chạy, chỉ chức năng "Mời nhân viên" bị tắt.
SUPABASE_SECRET_KEY=

# Địa chỉ app (dùng làm đường quay về trong email mời). Ví dụ: https://auto.minhky.vn
NEXT_PUBLIC_SITE_URL=

# Chỉ dùng khi chạy test database cục bộ (PostgreSQL thường, KHÔNG trỏ vào Supabase thật)
# TEST_DATABASE_URL=postgresql://postgres@/minhky_test?host=/tmp&port=54329
